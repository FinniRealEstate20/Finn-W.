# Supabase (Auth + DB) – EU-Region (Frankfurt) für DSGVO-Konformität
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic Claude API – KI-Assistent mit Guardrails (Chat + Smart-Fill-Selektor-Mapper)
ANTHROPIC_API_KEY=

# Smart-Pre-Fill: HMAC-Secret für die 15-Min-Bookmarklet-Tokens.
# In Production zwingend setzen (>=32 Zeichen, zufällig). Lokal optional.
RECIPE_TOKEN_SECRET=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# PropAfterCare – Environment Variables
# =============================================================================
# Copy to .env.local and fill the secrets. Anything prefixed with NEXT_PUBLIC_
# ships to the browser; everything else stays on the server.
# =============================================================================

# --- Supabase (Auth + DB) -- EU-Region (Frankfurt) for DSGVO compliance ------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic Claude (Chat-Assist + Smart-Fill selector mapper) ------------
ANTHROPIC_API_KEY=

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- PII encryption ----------------------------------------------------------
# Base64-encoded 32-byte key. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotate by adding a new line with incremented version and updating
# DATA_ENCRYPTION_ACTIVE_VERSION; old keys decrypt, active key encrypts.
DATA_ENCRYPTION_KEY_V1=
DATA_ENCRYPTION_ACTIVE_VERSION=1

# --- Smart-Pre-Fill bookmarklet token ----------------------------------------
# HMAC secret for the 15-minute bookmarklet tokens (>=32 chars random).
RECIPE_TOKEN_SECRET=

# --- Stripe billing ----------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# One price-id per tier (Starter / Pro / Business). Configure prices in the
# Stripe dashboard, paste the ids here. Lets you raise prices without code.
STRIPE_PRICE_ID_STARTER=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_BUSINESS=

# --- Email (Resend) ----------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="PropAfterCare <noreply@propaftercare.de>"

# --- Cron auth ---------------------------------------------------------------
# Shared secret for the /api/cron/* endpoints. Vercel Cron sends this as a
# Bearer token in the Authorization header.
CRON_SECRET=

# --- Observability (optional) -----------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
